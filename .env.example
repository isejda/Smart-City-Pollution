# Postgres
POSTGRES_DB=diploma
POSTGRES_USER=diploma
POSTGRES_PASSWORD=diploma
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Shared secret physical nodes send in the X-Device-Key header to POST /api/readings/
DEVICE_INGEST_KEY=change-me-to-a-random-device-key

# Superadmin created/updated by `seed_data` on every boot (Django admin + monitoring console)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123
